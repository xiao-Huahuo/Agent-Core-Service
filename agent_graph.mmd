flowchart TD
    internal_start["START"]
    safety_input["safety_input"]
    compress["compress"]
    planner["planner"]
    agent["agent"]
    action["action"]
    observation["observation"]
    safety_output["safety_output"]
    internal_end["END"]
    internal_start --> safety_input
    action --> observation
    agent -. "conditional" .-> internal_end
    agent -. "有 tool_calls" .-> action
    agent -. "无 tool_calls" .-> safety_output
    compress --> planner
    observation -. "answer / retry / abandon → 交给 agent" .-> agent
    observation -. "context overflow" .-> compress
    observation -. "continue → 更新计划" .-> planner
    planner -. "预算充足 → 主模型决策" .-> agent
    planner -. "规划后上下文超限 → 同步压缩" .-> compress
    safety_input -. "审核拦截" .-> internal_end
    safety_input -. "审核通过但上下文超限" .-> compress
    safety_input -. "审核通过且预算充足" .-> planner
    safety_output --> internal_end
